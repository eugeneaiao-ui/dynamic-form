{
  "name": "formino",
  "version": "0.1.0",
  "description": "Formino: a TypeScript dynamic form engine for React and Ant Design, with long forms, complex dependencies, low-code and AI-assisted development.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": {
        "import": "./dist/core.d.ts",
        "require": "./dist/core.d.cts"
      },
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./antd": {
      "types": {
        "import": "./dist/antd.d.ts",
        "require": "./dist/antd.d.cts"
      },
      "import": "./dist/antd.js",
      "require": "./dist/antd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./schemas/form-definition.schema.json": "./schemas/form-definition.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "CONTRIBUTING.md",
    "examples/quick-start",
    "examples/configuration",
    "llms.txt",
    "schemas",
    "examples/ai",
    "examples/advanced",
    "examples/performance/fixtures.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eugeneaiao-ui/formino.git"
  },
  "bugs": {
    "url": "https://github.com/eugeneaiao-ui/formino/issues"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsup && node scripts/copy-css.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:docs && npm test && npm run build && npm run build:demo",
    "test:package": "node scripts/package-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "prepack": "npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:smoke": "node scripts/benchmark.mjs --smoke",
    "examples:screenshots": "node scripts/benchmark.mjs --screenshots-only"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "antd": ">=4.24.0 <6",
    "react": ">=16.14.0 <20",
    "react-dom": ">=16.14.0 <20"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "8.17.1",
    "antd": "5.27.6",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "playwright": "1.65.1",
    "prettier": "3.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsup": "8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "homepage": "https://github.com/eugeneaiao-ui/formino#readme",
  "keywords": [
    "formino",
    "dynamic-form",
    "form-builder",
    "react",
    "antd",
    "typescript",
    "schema",
    "validation",
    "low-code",
    "schema-driven",
    "ai-assisted-development",
    "json-schema",
    "config-driven",
    "react-forms",
    "long-form",
    "field-dependencies"
  ],
  "publishConfig": {
    "access": "public"
  }
}
