{
  "repository": "eugeneaiao-ui/formino",
  "merge_settings": {
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "delete_branch_on_merge": true,
    "allow_update_branch": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY"
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_workflow_approval": {
    "approval_policy": "all_external_contributors"
  },
  "ci_gate": {
    "check_name": "Library checks",
    "required": false,
    "reason": "GitHub Actions is currently blocked by an account billing restriction. Maintainers must record local verification; enable the required check after successful runs."
  }
}
