{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eugeneaiao-ui/dynamic-form/main/schemas/form-definition.schema.json",
  "title": "Dynamic Form serializable configuration v1",
  "description": "JSON subset of Dynamic Form configuration for low-code applications and AI-assisted form generation. This describes configuration, not submitted form data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "template"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "template": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/templateField"
      }
    },
    "fields": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "maxLength": 256,
        "not": {
          "enum": ["__proto__", "constructor", "prototype"]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "segment": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "not": {
            "enum": ["__proto__", "constructor", "prototype"]
          }
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/segment"
            },
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      ]
    },
    "templateField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "enum": ["Input", "NumberInput", "Select", "RichTextSelect", "TextArea", "Date", "Span", "Title"]
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": ["Span", "Title"]
                }
              }
            }
          },
          "then": {
            "required": ["name"],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "type": {
          "enum": ["string", "number", "integer", "boolean", "array", "email", "url"]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "len": {
          "type": "integer",
          "minimum": 0
        },
        "whitespace": {
          "type": "boolean"
        }
      }
    },
    "componentProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placeholder": {
          "type": "string",
          "maxLength": 500
        },
        "disabled": {
          "type": "boolean"
        },
        "allowClear": {
          "type": "boolean"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "showCount": {
          "type": "boolean"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mode": {
          "enum": ["multiple", "tags"]
        },
        "options": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "format": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "tooltip": {
          "type": "string",
          "maxLength": 1000
        },
        "hidden": {
          "type": "boolean"
        },
        "preserve": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "componentProps": {
          "$ref": "#/$defs/componentProps"
        },
        "dataSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
